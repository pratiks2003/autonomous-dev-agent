/**
 * Every GitHub write the agent performs. All operations are idempotent so a
 * re-run on the same day never duplicates branches, PRs or releases.
 */
public with sharing class GitHubLifecycleService {
  public static final String README_START = '<!-- AGENT:START -->';
  public static final String README_END = '<!-- AGENT:END -->';

  public class ShipResult {
    public String branch;
    public Integer prNumber;
    public String prUrl;
    public String prNodeId;
    public String headSha;
    public Boolean autoMergeEnabled = false;
    public Boolean merged = false;
    public String mergeSha;
  }

  // ------------------------------------------------------------------ Branch, commits, PR, review, merge

  public static ShipResult ship(
    AgentPipelineState state,
    Map<String, Object> gen
  ) {
    AgentConfig cfg = AgentConfig.get();
    String base = '/repos/' + cfg.fullRepo();
    ShipResult r = new ShipResult();
    r.branch = 'agent/quest-' + state.issueNumber;

    // 1. Branch (422 = already exists -> reuse)
    AgentHttp.Result refRes = AgentHttp.github(
      'POST',
      base + '/git/refs',
      new Map<String, Object>{
        'ref' => 'refs/heads/' + r.branch,
        'sha' => state.baseSha
      }
    );
    if (!refRes.ok() && refRes.status != 422) {
      AgentHttp.require(refRes, 'Create branch');
    }

    // 2. Two commits: implementation, then unit test
    putFile(
      base,
      r.branch,
      (String) gen.get('filePath'),
      (String) gen.get('fileContent'),
      (String) gen.get('commitMessage')
    );
    r.headSha = putFile(
      base,
      r.branch,
      (String) gen.get('unitTestPath'),
      (String) gen.get('unitTestContent'),
      'test: cover ' + gen.get('filePath') + ' (#' + state.issueNumber + ')'
    );

    // 2b. Keep the public API in sync: re-export the new module from src/index.ts
    String indexSha = ensureIndexExport(
      base,
      r.branch,
      (String) gen.get('filePath')
    );
    if (indexSha != null) {
      r.headSha = indexSha;
    }

    // 3. Pull request (reuse an open one for the same head)
    AgentHttp.Result existing = AgentHttp.github(
      'GET',
      base +
        '/pulls?state=open&head=' +
        EncodingUtil.urlEncode(cfg.owner + ':' + r.branch, 'UTF-8'),
      null
    );
    Map<String, Object> pr;
    if (existing.ok() && !existing.jsonList().isEmpty()) {
      pr = (Map<String, Object>) existing.jsonList()[0];
    } else {
      String body =
        (String) gen.get('prBody') +
        '\n\nCloses #' +
        state.issueNumber +
        '\n\n---\n<sub>🤖 Shipped autonomously by Salesforce Apex + Einstein · run ' +
        AgentPipelineState.todayKey() +
        '</sub>';
      pr = AgentHttp.require(
          AgentHttp.github(
            'POST',
            base + '/pulls',
            new Map<String, Object>{
              'title' => (String) gen.get('prTitle'),
              'head' => r.branch,
              'base' => state.defaultBranch,
              'body' => body,
              'maintainer_can_modify' => true
            }
          ),
          'Open pull request'
        )
        .json();
    }
    r.prNumber = (Integer) pr.get('number');
    r.prUrl = (String) pr.get('html_url');
    r.prNodeId = (String) pr.get('node_id');

    // 4. AI code review (COMMENT — GitHub does not allow approving your own PR)
    AgentHttp.github(
      'POST',
      base + '/pulls/' + r.prNumber + '/reviews',
      new Map<String, Object>{
        'event' => 'COMMENT',
        'commit_id' => r.headSha,
        'body' => '## 🔍 Automated Code Review\n\n' +
        (String) gen.get('codeReviewCritique') +
        '\n\n<sub>Generated by the agent\'s review pass — complexity, edge cases and security checked before merge.</sub>'
      }
    );

    // 5. Merge: prefer auto-merge (waits for required CI). Fall back to a direct squash merge.
    r.autoMergeEnabled = GitHubGraphQLService.enableAutoMerge(r.prNodeId);
    if (!r.autoMergeEnabled) {
      AgentHttp.Result m = AgentHttp.github(
        'PUT',
        base + '/pulls/' + r.prNumber + '/merge',
        new Map<String, Object>{
          'merge_method' => 'squash',
          'commit_title' => (String) gen.get('commitMessage') +
          ' (#' +
          r.prNumber +
          ')'
        }
      );
      if (m.ok()) {
        r.merged = true;
        r.mergeSha = (String) m.json().get('sha');
      }
    }
    return r;
  }

  /**
   * Appends `export * from "./<path>";` to src/index.ts on the branch when the new module
   * is not exported yet. Returns the new commit SHA, or null when nothing changed.
   */
  public static String ensureIndexExport(
    String base,
    String branch,
    String filePath
  ) {
    if (
      filePath == null ||
      !filePath.startsWith('src/') ||
      filePath == 'src/index.ts'
    ) {
      return null;
    }
    AgentHttp.Result idx = AgentHttp.github(
      'GET',
      base +
        '/contents/src/index.ts?ref=' +
        EncodingUtil.urlEncode(branch, 'UTF-8'),
      null
    );
    if (!idx.ok()) {
      return null;
    }
    String current = EncodingUtil.base64Decode(
        ((String) idx.json().get('content')).replaceAll('\\s', '')
      )
      .toString();
    String line = indexExportLine(filePath);
    String modulePath = line.substringBetween('"');
    if (
      current.contains('"' + modulePath + '"') ||
      current.contains('\'' + modulePath + '\'')
    ) {
      return null;
    }
    String next = current.endsWith('\n')
      ? current + line + '\n'
      : current + '\n' + line + '\n';
    Map<String, Object> res = AgentHttp.require(
        AgentHttp.github(
          'PUT',
          base + '/contents/src/index.ts',
          new Map<String, Object>{
            'message' => 'chore: export ' +
            modulePath +
            ' from the public API',
            'content' => EncodingUtil.base64Encode(Blob.valueOf(next)),
            'branch' => branch,
            'sha' => idx.json().get('sha')
          }
        ),
        'Update src/index.ts'
      )
      .json();
    return (String) ((Map<String, Object>) res.get('commit')).get('sha');
  }

  public static String indexExportLine(String filePath) {
    return 'export * from "./' +
      filePath.removeStart('src/').removeEnd('.ts') +
      '";';
  }

  /** Creates or updates a file on a branch. Returns the new commit SHA. */
  public static String putFile(
    String base,
    String branch,
    String path,
    String content,
    String message
  ) {
    Map<String, Object> payload = new Map<String, Object>{
      'message' => message,
      'content' => EncodingUtil.base64Encode(Blob.valueOf(content)),
      'branch' => branch
    };
    AgentHttp.Result current = AgentHttp.github(
      'GET',
      base +
        '/contents/' +
        path +
        '?ref=' +
        EncodingUtil.urlEncode(branch, 'UTF-8'),
      null
    );
    if (current.ok()) {
      payload.put('sha', current.json().get('sha'));
    }
    Map<String, Object> res = AgentHttp.require(
        AgentHttp.github('PUT', base + '/contents/' + path, payload),
        'Commit ' + path
      )
      .json();
    return (String) ((Map<String, Object>) res.get('commit')).get('sha');
  }

  // ------------------------------------------------------------------ Sweep yesterday's PRs

  /** Updates quests still waiting on auto-merge. Mutates the records; caller performs DML. */
  public static void sweep(List<Agent_Quest__c> pending) {
    AgentConfig cfg = AgentConfig.get();
    for (Agent_Quest__c q : pending) {
      if (q.PR_Number__c == null) {
        continue;
      }
      AgentHttp.Result res = AgentHttp.github(
        'GET',
        '/repos/' + cfg.fullRepo() + '/pulls/' + q.PR_Number__c.intValue(),
        null
      );
      if (!res.ok()) {
        continue;
      }
      Map<String, Object> pr = res.json();
      if (pr.get('merged') == true) {
        q.Status__c = 'Shipped';
        q.Commit_SHA__c = (String) pr.get('merge_commit_sha');
        q.Shipped_At__c = parseGitHubDate((String) pr.get('merged_at'));
      } else if (pr.get('state') == 'closed') {
        q.Status__c = 'Failed';
      } else if (
        q.LastModifiedDate != null &&
        q.LastModifiedDate < Datetime.now().addDays(-3)
      ) {
        // Stuck for 3+ days (CI failing): close it so the issue gets re-attempted fresh.
        AgentHttp.github(
          'POST',
          '/repos/' +
            cfg.fullRepo() +
            '/issues/' +
            q.PR_Number__c.intValue() +
            '/comments',
          new Map<String, Object>{
            'body' => '🤖 Closing: CI did not pass within 3 days. The quest will be re-attempted.'
          }
        );
        AgentHttp.github(
          'PATCH',
          '/repos/' + cfg.fullRepo() + '/pulls/' + q.PR_Number__c.intValue(),
          new Map<String, Object>{ 'state' => 'closed' }
        );
        q.Status__c = 'Queued';
        q.PR_Number__c = null;
        q.PR_Url__c = null;
      }
    }
  }

  // ------------------------------------------------------------------ Weekly semantic release

  public static String publishRelease(Integer week, String notes) {
    AgentConfig cfg = AgentConfig.get();
    String tag = 'v1.' + week + '.0';
    AgentHttp.Result res = AgentHttp.github(
      'POST',
      '/repos/' + cfg.fullRepo() + '/releases',
      new Map<String, Object>{
        'tag_name' => tag,
        'name' => tag +
        ' — Week ' +
        week +
        ' of autonomous development',
        'body' => notes,
        'generate_release_notes' => false,
        'make_latest' => 'true'
      }
    );
    if (res.ok() || res.status == 422) {
      return tag;
    }
    return null;
  }

  // ------------------------------------------------------------------ Living profile README

  public static String buildProfileBlock(
    Integer streak,
    String prTitle,
    String prUrl,
    String releaseTag,
    String siteUrl
  ) {
    String prCell = prUrl == null
      ? '—'
      : '[' + prTitle.replace('|', '/') + '](' + prUrl + ')';
    String dash = String.isBlank(siteUrl)
      ? '—'
      : '[Agent Command Center](' + siteUrl + ')';
    return README_START +
      '\n### 🤖 Autonomous Dev Agent — live status\n\n' +
      '| 🔥 Streak | 🚢 Latest shipped PR | 🏷️ Release | 📡 Live dashboard |\n|---|---|---|---|\n' +
      '| **' +
      streak +
      (streak == 1 ? ' day** | ' : ' days** | ') +
      prCell +
      ' | `' +
      (releaseTag == null ? 'pre-release' : releaseTag) +
      '` | ' +
      dash +
      ' |\n\n' +
      '<sub>Updated ' +
      Datetime.now().format('yyyy-MM-dd HH:mm', 'Asia/Kolkata') +
      ' IST by a Salesforce Apex agent powered by the Einstein Models API. ' +
      'Every commit, PR, review and issue in this block is produced autonomously.</sub>\n' +
      README_END;
  }

  public static Boolean updateProfileReadme(String block) {
    AgentConfig cfg = AgentConfig.get();
    String path =
      '/repos/' +
      cfg.owner +
      '/' +
      cfg.profileRepo +
      '/contents/README.md';
    AgentHttp.Result current = AgentHttp.github('GET', path, null);
    String existing = '';
    Map<String, Object> payload = new Map<String, Object>{
      'message' => 'chore(profile): refresh autonomous agent status'
    };
    if (current.ok()) {
      Map<String, Object> file = current.json();
      payload.put('sha', file.get('sha'));
      existing = EncodingUtil.base64Decode(
          ((String) file.get('content')).replaceAll('\\s', '')
        )
        .toString();
    }
    payload.put(
      'content',
      EncodingUtil.base64Encode(Blob.valueOf(mergeBlock(existing, block)))
    );
    return AgentHttp.github('PUT', path, payload).ok();
  }

  public static String mergeBlock(String existing, String block) {
    if (String.isBlank(existing)) {
      return '# Hi, I\'m ' + AgentConfig.get().owner + ' 👋\n\n' + block + '\n';
    }
    Integer s = existing.indexOf(README_START);
    Integer e = existing.indexOf(README_END);
    if (s >= 0 && e > s) {
      return existing.substring(0, s) +
        block +
        existing.substring(e + README_END.length());
    }
    return existing.trim() + '\n\n' + block + '\n';
  }

  // ------------------------------------------------------------------ Helpers

  public static Integer streakFromSnapshot(String snapshotJson) {
    if (String.isBlank(snapshotJson)) {
      return 0;
    }
    List<Object> days = (List<Object>) ((Map<String, Object>) JSON.deserializeUntyped(
        snapshotJson
      ))
      .get('days');
    Integer streak = 0;
    Boolean skippedToday = false;
    for (Integer i = days.size() - 1; i >= 0; i--) {
      Integer count = (Integer) ((List<Object>) days[i])[1];
      if (count > 0) {
        streak++;
      } else if (i == days.size() - 1 && !skippedToday) {
        skippedToday = true; // today may not be counted yet
      } else {
        break;
      }
    }
    return streak;
  }

  public static Datetime parseGitHubDate(String iso) {
    if (String.isBlank(iso)) {
      return Datetime.now();
    }
    return (Datetime) JSON.deserialize('"' + iso + '"', Datetime.class);
  }
}
