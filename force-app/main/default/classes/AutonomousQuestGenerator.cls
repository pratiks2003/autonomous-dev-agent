/**
 * Keeps the quest backlog healthy. When fewer than Min_Open_Quests__c open
 * `agent-quest` issues exist, asks the Einstein LLM to invent a meaningful, small, testable
 * engineering task grounded in the repository, opens it as a GitHub issue
 * (Issues axis) and returns the matching Agent_Quest__c (caller performs DML).
 */
public with sharing class AutonomousQuestGenerator {
  public static final List<String> QUEST_TYPES = new List<String>{
    'Feature',
    'Unit_Test',
    'Refactor',
    'Docs',
    'Challenge'
  };

  private static final String SYSTEM_PROMPT =
    'You are the planning brain of an autonomous software engineer that ships one small pull request per day ' +
    'to a TypeScript utility library. Invent exactly ONE new engineering quest that a careful engineer could ' +
    'finish in a single PR touching one source file under src/ and one Vitest test file under tests/. ' +
    'Prefer genuinely useful work: new well-scoped utilities (strings, arrays, dates, math, data structures, ' +
    'algorithms, validation, async helpers), deeper test coverage for existing code, or focused refactors. ' +
    'Never duplicate an existing file or open issue. Never touch CI, workflows, package.json or config files. ' +
    'The body must be GitHub markdown with sections: Context, Task, Acceptance Criteria (checkbox list), Edge Cases.';

  public static Boolean needsQuest(Integer openCount) {
    return openCount < AgentConfig.get().minOpenQuests;
  }

  public static Agent_Quest__c generate(
    GitHubGraphQLService.RepoContext ctx,
    List<String> recentTitles
  ) {
    AgentConfig cfg = AgentConfig.get();
    List<String> openTitles = new List<String>();
    for (GitHubGraphQLService.IssueInfo i : ctx.openQuests) {
      openTitles.add('#' + i.num + ' ' + i.title);
    }
    String userPrompt =
      'Repository: ' +
      cfg.fullRepo() +
      '\n\n## README (excerpt)\n' +
      AgentHttp.abbreviate(ctx.readme, 3000) +
      '\n\n## Agent guide\n' +
      AgentHttp.abbreviate(ctx.guide, 2500) +
      '\n\n## File tree\n' +
      String.join(limitList(ctx.filePaths, 200), '\n') +
      '\n\n## Open quests (do not duplicate)\n' +
      (openTitles.isEmpty() ? '(none)' : String.join(openTitles, '\n')) +
      '\n\n## Recently shipped (do not repeat)\n' +
      (recentTitles.isEmpty() ? '(none)' : String.join(recentTitles, '\n')) +
      '\n\nToday is ' +
      AgentPipelineState.todayKey() +
      '. Return the quest JSON.';

    Map<String, Object> out = AgentLLMClient.createJson(
      SYSTEM_PROMPT,
      userPrompt +
        '\n\nField rules: questType must be one of Feature, Unit_Test, Refactor, Docs, Challenge. ' +
        'priority must be one of "1".."5" (1 = most valuable). ragTags: 3-6 comma-separated retrieval keywords.',
      new List<String>{ 'title', 'body', 'questType', 'ragTags', 'priority' }
    );

    String title = AgentHttp.abbreviate((String) out.get('title'), 240);
    String questType = QUEST_TYPES.contains((String) out.get('questType'))
      ? (String) out.get('questType')
      : 'Feature';
    String body =
      (String) out.get('body') +
      '\n\n---\n<sub>🤖 Self-generated by the autonomous Salesforce agent · type: `' +
      questType +
      '` · rag: `' +
      out.get('ragTags') +
      '`</sub>';

    Integer issueNumber = createIssue(title, body, questType);
    return new Agent_Quest__c(
      Title__c = title,
      Description__c = AgentHttp.abbreviate(body, 32000),
      GitHub_Issue_Number__c = issueNumber,
      Repository_Name__c = cfg.fullRepo(),
      Quest_Type__c = questType,
      Status__c = 'Queued',
      RAG_Context_Tags__c = AgentHttp.abbreviate(
        (String) out.get('ragTags'),
        250
      ),
      Priority__c = parsePriority((String) out.get('priority')),
      Self_Generated__c = true
    );
  }

  /** Opens the GitHub issue with agent-quest + type labels. Returns the issue number. */
  public static Integer createIssue(
    String title,
    String body,
    String questType
  ) {
    AgentConfig cfg = AgentConfig.get();
    AgentHttp.Result res = AgentHttp.require(
      AgentHttp.github(
        'POST',
        '/repos/' + cfg.fullRepo() + '/issues',
        new Map<String, Object>{
          'title' => title,
          'body' => body,
          'labels' => new List<String>{
            'agent-quest',
            'type:' + questType.toLowerCase()
          }
        }
      ),
      'Create issue'
    );
    return (Integer) res.json().get('number');
  }

  /** Publishes admin-queued quests (from the dashboard) as GitHub issues. */
  public class PublishJob implements Queueable, Database.AllowsCallouts {
    private Id questId;
    public PublishJob(Id questId) {
      this.questId = questId;
    }
    public void execute(QueueableContext qc) {
      Agent_Quest__c q = [
        SELECT Id, Title__c, Description__c, Quest_Type__c
        FROM Agent_Quest__c
        WHERE Id = :questId
        WITH SECURITY_ENFORCED
      ];
      String body =
        (q.Description__c == null ? '' : q.Description__c) +
        '\n\n---\n<sub>🧑‍💻 Queued from the Agent Command Center</sub>';
      q.GitHub_Issue_Number__c = createIssue(
        q.Title__c,
        body,
        q.Quest_Type__c == null ? 'Feature' : q.Quest_Type__c
      );
      update q;
    }
  }

  @TestVisible
  private static Integer parsePriority(String raw) {
    String digits = raw == null ? '' : raw.replaceAll('[^1-5]', '');
    return digits.length() > 0 ? Integer.valueOf(digits.substring(0, 1)) : 3;
  }

  private static List<String> limitList(List<String> items, Integer max) {
    List<String> out = new List<String>();
    for (Integer i = 0; i < items.size() && i < max; i++) {
      out.add(items[i]);
    }
    return out;
  }
}
